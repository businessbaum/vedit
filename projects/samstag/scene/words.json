 "sents": [
  {
   "start": 0.0,
   "end": 2.54,
   "text": "Manche Menschen haben Pech und es gibt Roy."
  },
  {
   "start": 2.54,
   "end": 4.5,
   "text": "Ein Mann, der so oft vom Blitz getroffen wurde,"
  },
  {
   "start": 4.5,
   "end": 6.34,
   "text": "dass selbst die Statistik irgendwann sagt:"
  },
  {
   "start": 6.34,
   "end": 7.34,
   "text": "Abschieben nach Asgard."
  },
  {
   "start": 7.34,
   "end": 8.84,
   "text": "Offiziell sieben Treffer."
  },
  {
   "start": 8.84,
   "end": 9.98,
   "text": "Roy selbst behauptete es"
  },
  {
   "start": 9.984,
   "end": 12.244,
   "text": "Es gab noch mehr, aber die konnten nicht nachgewiesen werden."
  },
  {
   "start": 12.244,
   "end": 14.424,
   "text": "Einmal schlägt der Blitz in seinem Wachturm ein."
  },
  {
   "start": 14.424,
   "end": 15.624,
   "text": "Zack, verbranntes Bein."
  },
  {
   "start": 15.624,
   "end": 19.964,
   "text": "Einmal im Auto, Augenbrauen und Haare, im Vorgarten, Schulter, Ranger-Station,"
  },
  {
   "start": 19.968,
   "end": 25.568,
   "text": "Nach dem vierten Mal fing er an, Wasser mit sich herumzutragen, falls er wieder einmal anfängt zu brennen."
  },
  {
   "start": 25.568,
   "end": 29.948,
   "text": "Menschen hielten irgendwann Abstand zu ihm, niemand will neben einem Blitzmagneten stehen."
  },
  {
   "start": 29.951999999999998,
   "end": 34.772,
   "text": "er vor einer Gewitterwolke wegzufahren. Als er dachte, die Luft ist rein, steigt er aus dem Auto"
  },
  {
   "start": 34.772,
   "end": 39.932,
   "text": "und wurde zum fünften Mal getroffen. Wieder musste er seine Haare löschen. Sechstes Mal Knöchel und Haare,"
  },
  {
   "start": 39.936,
   "end": 43.196,
   "text": "und ein siebtes Mal beim Angeln, Oberkörper und natürlich die Haare."
  },
  {
   "start": 43.196,
   "end": 46.376,
   "text": "Die Chance sieben Mal vom Blitz getroffen zu werden ist schön und gut,"
  },
  {
   "start": 46.376,
   "end": 49.916,
   "text": "aber ein bisschen unrealistisch wird es, wenn er sagt, er musste mit brennenden Haaren"
  },
  {
   "start": 49.92,
   "end": 52.26,
   "text": "gegen einen Bären kämpfen, um zu seinem Auto zu kommen."
  },
  {
   "start": 52.26,
   "end": 53.46,
   "text": "Ich hasse es, wenn das passiert."
  }
 ]
}